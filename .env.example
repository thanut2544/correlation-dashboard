# ==========================================
#   Trader Correlation Dashboard - Config
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ

# ── Port ──────────────────────────────────
PORT=4000

# ── บัญชีเทรด ────────────────────────────
# ใส่ยอดเงินในบัญชีจริง (USD)
ACCOUNT_BALANCE=500

# บัญชีต่ำกว่าเท่าไรถึงเป็น Pocket Mode (lot 0.01 fixed)
POCKET_MODE_THRESHOLD=2000

# ── Farm Dollar: เป้าหมายรายวัน ─────────
# กำไรสูงสุดต่อวัน (pips) — ถึงแล้วหยุดเทรดทันที
DAILY_TARGET_PIPS=20

# ขาดทุนสูงสุดต่อวัน (pips) — ถึงแล้วหยุดเทรดทันที
DAILY_DRAWDOWN_PIPS=15

# จำนวน pairs ที่เปิดพร้อมกันได้สูงสุด
# Pocket Mode: แนะนำ 2, Regular Mode: แนะนำ 3
MAX_CONCURRENT_TRADES=2

# ── Session ───────────────────────────────
# เวลาที่อนุญาตให้เทรด: london, ny, หรือ all
# london = 14:00-23:00 ไทย, ny = 19:00-04:00 ไทย
ALLOW_SESSIONS=london,ny

# ── Z-Score (อย่าแก้ถ้าไม่แน่ใจ) ────────
# เข้าเทรดเมื่อ spread ห่างจาก mean เท่าไร
Z_ENTRY=2.5
Z_ENTRY_STRICT=3.0
Z_TP=0.5
Z_STOP_LOSS=3.5

# ── Redis (ไม่บังคับ) ────────────────────
# ถ้าต้องการให้ประวัติเทรดอยู่แม้ restart
# REDIS_URL=redis://localhost:6379
